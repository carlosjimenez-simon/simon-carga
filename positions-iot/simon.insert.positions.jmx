        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Inter tabla Events" enabled="false">
          <stringProp name="dataSource">PoolPositions</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT INTO public.tc_events (
    -- Campos Requeridos (NOT NULL)
    &quot;type&quot;,
    eventtime,
    
    -- Campos Opcionales (NULL) o de Referencia
    deviceid,
    positionid,
    geofenceid,
    &quot;attributes&quot;
)
VALUES (
    -- &quot;type&quot; (VARCHAR): Requerido. Tipos comunes: geofenceEnter, alarm, ignitionOn, deviceOffline.
    &apos;geofenceEnter&apos;, 

    -- eventtime (TIMESTAMP): Requerido. El momento en que ocurrió el evento.
    now(), 

    -- deviceid (INT4): Opcional (pero recomendado). ID del dispositivo que generó el evento.
    100, 

    -- positionid (INT4): Opcional. ID de la posición asociada (si el evento se basa en una posición).
    45678, 

    -- geofenceid (INT4): Opcional. ID de la geocerca (si el tipo es geofenceEnter/geofenceExit).
    10, 

    -- &quot;attributes&quot; (VARCHAR): Opcional. Metadatos adicionales en formato JSON.
    &apos;{&quot;alertType&quot;: &quot;priority&quot;, &quot;velocity&quot;: 65.2}&apos;
),
(
    -- &quot;type&quot; (VARCHAR): Requerido. Tipos comunes: geofenceEnter, alarm, ignitionOn, deviceOffline.
    &apos;geofenceEnter&apos;, 

    -- eventtime (TIMESTAMP): Requerido. El momento en que ocurrió el evento.
    now(), 

    -- deviceid (INT4): Opcional (pero recomendado). ID del dispositivo que generó el evento.
    100, 

    -- positionid (INT4): Opcional. ID de la posición asociada (si el evento se basa en una posición).
    45678, 

    -- geofenceid (INT4): Opcional. ID de la geocerca (si el tipo es geofenceEnter/geofenceExit).
    10, 

    -- &quot;attributes&quot; (VARCHAR): Opcional. Metadatos adicionales en formato JSON.
    &apos;{&quot;alertType&quot;: &quot;priority&quot;, &quot;velocity&quot;: 65.2}&apos;
),
(
