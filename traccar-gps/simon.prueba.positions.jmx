          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// 1. Obtener la latitud y longitud actuales de las variables
double lat = Double.parseDouble(vars.get(&quot;lat&quot;))
double lon = Double.parseDouble(vars.get(&quot;lon&quot;))
double speed = Double.parseDouble(vars.get(&quot;speed&quot;))

// 2. Calcular un pequeño desplazamiento basado en la velocidad (simular movimiento real)
// Un valor de ~0.0002 en coordenadas equivale a ~20 metros
double deltaLat = (Math.random() - 0.4) * 0.0003
double deltaLon = (Math.random() - 0.4) * 0.0003

// 3. Calcular la nueva posición
double newLat = lat + deltaLat
double newLon = lon + deltaLon

// 4. Actualizar las variables de JMeter con 6 decimales de precisión
vars.put(&quot;lat&quot;, String.format(Locale.US, &quot;%.6f&quot;, newLat))
vars.put(&quot;lon&quot;, String.format(Locale.US, &quot;%.6f&quot;, newLon))</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
